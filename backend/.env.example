# General
NODE_ENV=development

# Backend server
DW_PORT=4004
DW_HTTPS=false
DW_PRIVATE_KEY=/etc/ssl/darywin.key
DW_CERTIFICATE=/etc/ssl/darywin.pem

# MongoDB
DW_DB_URI="mongodb://admin:PASSWORD@127.0.0.1:27017/darywin?authSource=admin&appName=darywin"
DW_DB_SSL=false
DW_DB_SSL_CERT=/etc/ssl/darywin.pem
DW_DB_SSL_CA=/etc/ssl/darywin.pem
DW_DB_DEBUG=true
DW_DB_SERVER_SIDE_JAVASCRIPT=false

# Auth
# Required. Generate fresh ≥32-byte random values per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Server REFUSES to boot if these equal the previously shipped public defaults.
DW_COOKIE_SECRET=REPLACE_WITH_RANDOM_BASE64
DW_JWT_SECRET=REPLACE_WITH_RANDOM_BASE64
DW_AUDIT_PEPPER=REPLACE_WITH_RANDOM_BASE64
DW_AUTH_COOKIE_DOMAIN=localhost
# Very important: must match your admin/frontend URLs exactly, otherwise auth and CORS won't work
# For production, use your real domains (e.g. https://admin.darywin.com/)
# WARNING: Do NOT add inline comments — Docker env_file includes them in the value
DW_ADMIN_HOST=http://localhost:3003/
DW_FRONTEND_HOST=http://localhost:3004/
DW_JWT_EXPIRE_AT=86400
DW_TOKEN_EXPIRE_AT=86400

# Email (SMTP)
DW_SMTP_HOST=smtp.sendgrid.net
DW_SMTP_PORT=587
DW_SMTP_USER=apikey
DW_SMTP_PASS="PASSWORD"
DW_SMTP_FROM=no-reply@darywin.com

# CDN (File storage)
DW_CDN_ROOT=/var/www/cdn
DW_CDN_USERS=/var/www/cdn/darywin/users
DW_CDN_TEMP_USERS=/var/www/cdn/darywin/temp/users
DW_CDN_PROPERTIES=/var/www/cdn/darywin/properties
DW_CDN_TEMP_PROPERTIES=/var/www/cdn/darywin/temp/properties
DW_CDN_LOCATIONS=/var/www/cdn/darywin/locations
DW_CDN_TEMP_LOCATIONS=/var/www/cdn/darywin/temp/locations

# Localization
DW_DEFAULT_LANGUAGE=en

# Business Rules
DW_MINIMUM_AGE=21

# Expo
DW_EXPO_ACCESS_TOKEN=EXPO_ACCESS_TOKEN

# Stripe
DW_STRIPE_SECRET_KEY=STRIPE_SECRET_KEY
DW_STRIPE_SESSION_EXPIRE_AT=82800

# PayPal
DW_PAYPAL_SANDBOX=true
DW_PAYPAL_CLIENT_ID=PAYPAL_CLIENT_ID
DW_PAYPAL_CLIENT_SECRET=PAYPAL_CLIENT_SECRET

# Admin
DW_ADMIN_EMAIL=admin@darywin.com

# Google reCAPTCHA
DW_RECAPTCHA_SECRET=RECAPTCHA_SECRET

# Misc
DW_WEBSITE_NAME="DaryWin"
# Timezone for converting dates from UTC to local time (used in emails sent from backend)
# TZ identifier: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DW_TIMEZONE=UTC

# IPInfo (Geo lookup)
# Required for more than 1000 requests/day
DW_IPINFO_API_KEY=IPINFO_API_KEY
DW_IPINFO_DEFAULT_COUNTRY=DZ

# Language cleanup job
# Number of documents to process per batch when deleting obsolete language values
DW_BATCH_SIZE=1000

# Sentry (Error monitoring & performance tracing)
# Set to true to enable Sentry
DW_ENABLE_SENTRY=false
# Your backend DSN (keep it secret)
DW_SENTRY_DSN_BACKEND=https://your_dsn@o0.ingest.sentry.io/your_project_id
# Tracing sample rate: 1.0 = 100%, 0.1 = 10%, 0 = disabled
DW_SENTRY_TRACES_SAMPLE_RATE=1.0
