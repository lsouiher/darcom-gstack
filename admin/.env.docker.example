VITE_NODE_ENV=production
VITE_DW_API_HOST=http://localhost:4004
VITE_DW_DEFAULT_LANGUAGE=en
VITE_DW_PAGE_SIZE=30
VITE_DW_PROPERTIES_PAGE_SIZE=15
VITE_DW_BOOKINGS_PAGE_SIZE=20
VITE_DW_BOOKINGS_MOBILE_PAGE_SIZE=10
VITE_DW_CDN_USERS=http://localhost:4004/cdn/darywin/users
