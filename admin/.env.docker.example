VITE_DW_CDN_PROPERTIES=http://localhost:4004/cdn/darywin/properties
VITE_DW_CDN_TEMP_PROPERTIES=http://localhost:4004/cdn/darywin/temp/properties
VITE_DW_CDN_LOCATIONS=http://localhost:4004/cdn/darywin/locations
VITE_DW_CDN_TEMP_LOCATIONS=http://localhost:4004/cdn/darywin/temp/locations
VITE_DW_AGENCY_IMAGE_WIDTH=60
VITE_DW_AGENCY_IMAGE_HEIGHT=30
VITE_DW_PROPERTY_IMAGE_WIDTH=300
VITE_DW_PROPERTY_IMAGE_HEIGHT=200
VITE_DW_MINIMUM_AGE=21
